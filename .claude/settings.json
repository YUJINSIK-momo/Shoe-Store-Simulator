{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run lint:*)",
      "Bash(npm run type-check)",
      "Bash(npm run verify)",
      "Bash(npm start)",
      "Bash(npm test)",
      "Bash(npm test:*)",
      "Bash(npx tsc:*)",
      "Bash(npx expo lint)",
      "Bash(sh scripts/verify.sh)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Read(*)",
      "Glob(*)",
      "Grep(*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(npm install:*)",
      "Bash(npm uninstall:*)",
      "Bash(npm publish:*)",
      "Bash(eas build:*)",
      "Bash(eas submit:*)",
      "Write(*)",
      "Edit(*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(curl:* | sh)",
      "Bash(curl:* | bash)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "npm run lint --silent || echo '[Claude] lint 실패 — 다음 작업 전 수정 권장'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npm run verify --silent || echo '[Claude] verify 실패 — type-check/lint 오류를 확인하세요'"
          }
        ]
      }
    ]
  }
}
